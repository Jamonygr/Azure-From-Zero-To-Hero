# Copy to terraform.tfvars. Replace the documentation address with your own
# single public IP in CIDR form before deploying the RDP NAT rule.
subscription_id = null
environment     = "dev"
location        = "eastus2"
name_prefix     = "clz"
admin_username  = "clzadmin"
admin_cidr      = "203.0.113.10/32"
vm_size         = "Standard_B2s"
