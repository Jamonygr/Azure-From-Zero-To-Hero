# Copy to terraform.tfvars for local runs. Keep real values out of commits.
subscription_id = null
environment     = "dev"
location        = "eastus2"
name_prefix     = "clz"

admin_username = "clzadmin"
vm_size        = "Standard_B2s"
instance_count = 2

# Replace with your current public IPv4 address before deployment.
key_vault_access_cidr = "203.0.113.10/32"
