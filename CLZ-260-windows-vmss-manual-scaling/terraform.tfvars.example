# Copy to terraform.tfvars. VMSS instances have no direct RDP path; HTTP and
# outbound connectivity use the module's Standard Load Balancer.
subscription_id = null
environment     = "dev"
location        = "eastus2"
name_prefix     = "clz"
admin_username  = "clzadmin"
instance_count  = 2
vm_size         = "Standard_B2s"
