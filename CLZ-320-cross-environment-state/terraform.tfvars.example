# Copy to terraform.tfvars for local runs. Keep real values out of commits.
subscription_id = null
environment     = "dev"
location        = "eastus2"
name_prefix     = "clz"

# Replace every value with the backend coordinates created in CLZ-310.
# The placeholder storage account is intentionally rejected by validation.
remote_state = {
  resource_group_name  = "clz-dev-clz310-rg"
  storage_account_name = "replacewithstateaccount"
  container_name       = "tfstate"
  key                  = "clz310.tfstate"
}
