# Copy to terraform.tfvars. All capacity values are whole numbers, ordered
# minimum <= default <= maximum, and capped at five for this cost-aware lesson.
subscription_id = null
environment     = "dev"
location        = "eastus2"
name_prefix     = "clz"
admin_username  = "clzadmin"
vm_size         = "Standard_B2s"

autoscale_capacity = {
  minimum = 2
  default = 2
  maximum = 4
}
